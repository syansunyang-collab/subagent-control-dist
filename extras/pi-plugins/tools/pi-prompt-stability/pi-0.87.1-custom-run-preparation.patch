+	/**
+	 * Start a run from a custom message. It skips user-input processing but not run preparation:
+	 * without before_agent_start the run would fall back to the base prompt options, dropping
+	 * extension sections from the request and recording their removal in the transcript (#5581).
+	 */
+	private async _runCustomMessageTurn(appMessage: CustomMessage): Promise<void> {
+		// Mark the run active before awaiting handlers so a message arriving meanwhile is queued
+		// for this run instead of starting a second one.
+		this._isAgentRunActive = true;
+		const messages: AgentMessage[] = [appMessage];
+		try {
+			const images =
+				typeof appMessage.content === "string"
+					? []
+					: appMessage.content.filter((part): part is ImageContent => part.type === "image");
+			const result = await this._emitBeforeAgentStart(
+				contentText(appMessage.content),
+				images.length > 0 ? images : undefined,
+				"custom",
+			);
+			this._applyAgentStart(result, messages);
+		} catch (error) {
+			this._isAgentRunActive = false;
+			throw error;
+		}
+		await this._runAgentPrompt(messages);
+	}
+
+	private async _emitBeforeAgentStart(
+		prompt: string,
+		images: ImageContent[] | undefined,
+		trigger: BeforeAgentStartEvent["trigger"],
+	): Promise<BeforeAgentStartCombinedResult> {
+		const selectedToolsBefore = this._baseSystemPromptOptions.selectedTools;
+		const result = await this._extensionRunner.emitBeforeAgentStart(
+			prompt,
+			images,
+			this._baseSystemPromptOptions,
+			trigger,
+		);
+		// Handlers may edit event.systemPromptOptions.selectedTools or call setActiveTools(),
+		// which updates the live loadout instead. An explicit edit wins; otherwise the live
+		// loadout is authoritative, so a setActiveTools() call is not undone here.
+		const handlerEditedTools =
+			result.systemPromptOptions.selectedTools.length !== selectedToolsBefore.length ||
+			result.systemPromptOptions.selectedTools.some((name, index) => name !== selectedToolsBefore[index]);
+		if (!handlerEditedTools) result.systemPromptOptions.selectedTools = this.getActiveToolNames();
+		return result;
+	}
+
+	/** Add handler messages and the run's prompt delta to the messages that start the run. */
+	private _applyAgentStart(result: BeforeAgentStartCombinedResult, messages: AgentMessage[]): void {
+		for (const msg of result.messages) {
+			messages.push({
+				role: "custom",
+				customType: msg.customType,
+				// Untyped extensions can pass null/missing content; normalize at ingestion.
+				content: msg.content ?? [],
+				display: msg.display,
+				details: msg.details,
+				timestamp: Date.now(),
+			});
+		}
+		const updateMessage = this._preparePromptAndToolLoadout(result.systemPromptOptions);
+		this._runSystemPromptOptions = result.systemPromptOptions;
+		if (updateMessage) messages.unshift(updateMessage);
+	}
