index 0000000..793a533
--- /dev/null
+++ b/packages/coding-agent/test/suite/regressions/5581-custom-message-run-preparation.test.ts
@@ -0,0 +1,163 @@
+import {
+	fauxAssistantMessage,
+	getCurrentSystemPrompt,
+	getInitialSystemMessage,
+	getSystemMessageText,
+	type TranscriptContext,
+} from "@earendil-works/pi-ai";
+import { afterEach, describe, expect, it } from "vitest";
+import type { BeforeAgentStartEvent, ExtensionFactory } from "../../../src/index.ts";
+import { createHarness, type Harness } from "../harness.ts";
+
+const POLICY = "Remember the policy.";
+
+// Adds a named section on every run, as memory and date extensions do.
+function sectionExtension(triggers: BeforeAgentStartEvent["trigger"][]): ExtensionFactory {
+	return (pi) => {
+		pi.on("before_agent_start", (event) => {
+			triggers.push(event.trigger);
+			event.systemPromptOptions.sections.policy = POLICY;
+		});
+	};
+}
+
+function recordRequests(harness: Harness, count: number): TranscriptContext[] {
+	const requests: TranscriptContext[] = [];
+	harness.setResponses(
+		Array.from({ length: count }, (_, index) => (context: TranscriptContext) => {
+			requests.push(context);
+			return fauxAssistantMessage(`reply ${index}`);
+		}),
+	);
+	return requests;
+}
+
+function leadingPrompt(context: TranscriptContext): string {
+	const initial = getInitialSystemMessage(context.messages);
+	return initial ? getSystemMessageText(initial) : "";
+}
+
+const notice = { customType: "completion", content: "background task finished", display: true };
+
+describe("#5581 custom-message runs go through run preparation", () => {
+	const harnesses: Harness[] = [];
+
+	afterEach(() => {
+		while (harnesses.length > 0) harnesses.pop()?.cleanup();
+	});
+
+	it("keeps extension sections for an idle wake between user prompts", async () => {
+		const triggers: BeforeAgentStartEvent["trigger"][] = [];
+		const harness = await createHarness({ extensionFactories: [sectionExtension(triggers)] });
+		harnesses.push(harness);
+		const requests = recordRequests(harness, 3);
+
+		await harness.session.prompt("first");
+		await harness.session.sendCustomMessage(notice, { deliverAs: "followUp", triggerTurn: true });
+		await harness.session.prompt("second");
+
+		expect(triggers).toEqual(["prompt", "custom", "prompt"]);
+		expect(requests).toHaveLength(3);
+		for (const request of requests) {
+			expect(getCurrentSystemPrompt(request.messages)).toContain(POLICY);
+			expect(leadingPrompt(request)).toBe(leadingPrompt(requests[0]!));
+		}
+		// Without preparation the wake recorded the section's removal and the next prompt re-added it.
+		const patches = harness.session.messages.flatMap((message) =>
+			message.role === "system" && message.sections ? [message.sections] : [],
+		);
+		expect(patches.some((sections) => sections.policy === null)).toBe(false);
+	});
+
+	it("drops a section its extension stopped writing before an idle wake", async () => {
+		let enabled = true;
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.on("before_agent_start", (event) => {
+						if (enabled) event.systemPromptOptions.sections.plan_mode = "Plan only.";
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		const requests = recordRequests(harness, 2);
+
+		await harness.session.prompt("plan");
+		enabled = false;
+		await harness.session.sendCustomMessage(notice, { deliverAs: "followUp", triggerTurn: true });
+
+		expect(getCurrentSystemPrompt(requests[0]!.messages)).toContain("Plan only.");
+		expect(getCurrentSystemPrompt(requests[1]!.messages)).not.toContain("Plan only.");
+	});
+
+	it("prepares the first run of a fresh session when a custom message starts it", async () => {
+		const triggers: BeforeAgentStartEvent["trigger"][] = [];
+		const harness = await createHarness({ extensionFactories: [sectionExtension(triggers)] });
+		harnesses.push(harness);
+		const requests = recordRequests(harness, 1);
+
+		await harness.session.sendCustomMessage(notice, { triggerTurn: true });
+
+		expect(triggers).toEqual(["custom"]);
+		expect(getCurrentSystemPrompt(requests[0]!.messages)).toContain(POLICY);
+		expect(getCurrentSystemPrompt(requests[0]!.messages)).toContain(harness.session.systemPrompt);
+	});
+
+	it("prepares a wake deferred while agent_settled handlers run", async () => {
+		const triggers: BeforeAgentStartEvent["trigger"][] = [];
+		let woke = false;
+		const harness = await createHarness({
+			extensionFactories: [
+				sectionExtension(triggers),
+				(pi) => {
+					pi.on("agent_settled", () => {
+						if (woke) return;
+						woke = true;
+						void pi.sendMessage(notice, { deliverAs: "followUp", triggerTurn: true });
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		const requests = recordRequests(harness, 2);
+
+		await harness.session.prompt("first");
+		await harness.session.waitForIdle();
+
+		expect(triggers).toEqual(["prompt", "custom"]);
+		expect(requests).toHaveLength(2);
+		expect(getCurrentSystemPrompt(requests[1]!.messages)).toContain(POLICY);
+	});
+
+	it("queues a second wake that arrives while the first is being prepared", async () => {
+		let release: (() => void) | undefined;
+		const gate = new Promise<void>((resolve) => {
+			release = resolve;
+		});
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.on("before_agent_start", async () => {
+						await gate;
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		const requests = recordRequests(harness, 2);
+
+		const first = harness.session.sendCustomMessage(notice, { deliverAs: "followUp", triggerTurn: true });
+		const second = harness.session.sendCustomMessage(
+			{ ...notice, content: "second task finished" },
+			{ deliverAs: "followUp", triggerTurn: true },
+		);
+		release?.();
+		await Promise.all([first, second]);
+		await harness.session.waitForIdle();
+
+		const custom = harness.session.messages.filter((message) => message.role === "custom");
+		expect(custom.map((message) => message.content)).toEqual(["background task finished", "second task finished"]);
+		expect(requests).toHaveLength(2);
+	});
+});
