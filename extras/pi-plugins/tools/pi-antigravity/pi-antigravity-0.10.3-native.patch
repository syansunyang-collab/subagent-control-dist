+import fs from "node:fs";
+import path from "node:path";
+
+function canonical(value) {
+  if (Array.isArray(value)) return value.map(canonical);
+  if (value && typeof value === "object") {
+    return Object.fromEntries(Object.keys(value).sort().map((key) => [key, canonical(value[key])]));
+  }
+  return value;
+}
+
+function sameJson(left, right) {
+  return JSON.stringify(canonical(left)) === JSON.stringify(canonical(right));
+}
+
+function emptyDirectory(directory) {
+  try {
+    fs.rmdirSync(directory);
+  } catch {
+    // Keep directories containing project-owned files.
+  }
+}
+
+export function createNativeAgentMarkdown(name, systemPrompt) {
+  if (!/^[a-zA-Z0-9_-]+$/.test(name)) throw new Error("Invalid Antigravity agent name.");
+  return `---\nname: ${name}\ndescription: Pi-native Antigravity agent.\nmainAgent: true\nsubagent: false\nexcludeDefaultComponents: true\ninheritCustomizations: false\ntools: []\n---\n\n${systemPrompt.replace(/\s+$/, "")}\n`;
+}
+
+/** Short MCP server name. The CLI tool id is `mcp_<server>_<Pi tool>` and must fit in 64 characters, so the server name cannot repeat the session id. */
+export function cliServerName(id) {
+  const suffix = String(id).replace(/[^a-zA-Z0-9]/g, "").slice(-8);
+  if (suffix.length < 8) throw new Error("Antigravity session id is too short for a CLI server name.");
+  return `b${suffix}`;
+}
+
+export function cliToolName(serverName, toolName, toolPrefix = "") {
+  return `mcp_${serverName}_${toolPrefix}${toolName}`;
+}
+
+/** Owns only one process/session's workspace MCP entry and custom agent. */
+export class NativeWorkspaceRegistration {
+  constructor({ cwd, id, serverName }) {
+    this.cwd = path.resolve(cwd);
+    this.id = String(id).replace(/[^a-zA-Z0-9_-]/g, "");
+    if (!this.id) throw new Error("A process/session identity is required for workspace registration.");
+    this.agentName = `pi-native-${this.id}`;
+    this.serverName = serverName ?? cliServerName(this.id);
+    this.toolPrefix = "";
+    this.configPath = path.join(this.cwd, ".agents", "mcp_config.json");
+    this.agentDirectory = path.join(this.cwd, ".agents", "agents", this.agentName);
+    this.agentPath = path.join(this.agentDirectory, "agent.md");
+    this.#agentContent = undefined;
+    this.#mcpEntry = undefined;
+    this.#originalConfig = undefined;
+    this.#originalConfigExisted = false;
+    this.#originalConfigRaw = undefined;
+  }
+
+  #agentContent;
+  #mcpEntry;
+  #originalConfig;
+  #originalConfigExisted;
+  #originalConfigRaw;
+
+  writeSystemPrompt(systemPrompt, tools = []) {
+    for (const tool of tools) {
+      const cliName = cliToolName(this.serverName, tool.name, this.toolPrefix);
+      if (!/^[a-zA-Z0-9_-]{1,64}$/.test(cliName)) {
+        throw new Error(`Antigravity CLI name is too long for Pi tool "${tool.name}": ${cliName}`);
+      }
+    }
+    const catalog = tools.map(({ name, description }) => `- ${name}: ${description}`).join("\n");
+    const routing = `\n\n<pi_tool_bridge>\nPi tools are available through call_mcp_tool. Set ServerName to "${this.serverName}" and ToolName to "${this.toolPrefix}<Pi tool name>"; pass the Pi tool arguments unchanged in Arguments. For example, read uses ToolName "${this.toolPrefix}read". Use the registered MCP tool schemas for parameter details.\n</pi_tool_bridge>`;
+    const content = createNativeAgentMarkdown(this.agentName, systemPrompt + routing + `\n\n<pi_active_tools>\nAll names below are Pi tools on the same bridge, including ordinary extension tools and the mcp gateway.\n${catalog}\n</pi_active_tools>`);
+    if (this.#agentContent === content) return false;
+    if (this.#agentContent === undefined && fs.existsSync(this.agentPath)) {
+      throw new Error(`Refusing to overwrite an existing agent: ${this.agentPath}`);
+    }
+    if (this.#agentContent !== undefined) {
+      const current = fs.readFileSync(this.agentPath, "utf8");
+      if (current !== this.#agentContent) {
+        throw new Error(`Agent file changed outside this session: ${this.agentPath}`);
+      }
+    }
+    fs.mkdirSync(this.agentDirectory, { recursive: true });
+    fs.writeFileSync(this.agentPath, content, "utf8");
+    this.#agentContent = content;
+    return true;
+  }
+
+  registerMcpServer(url, token) {
+    if (this.#mcpEntry) return;
+    const existed = fs.existsSync(this.configPath);
+    const originalRaw = existed ? fs.readFileSync(this.configPath, "utf8") : undefined;
+    const config = originalRaw === undefined ? {} : JSON.parse(originalRaw);
+    if (!config || typeof config !== "object" || Array.isArray(config)) {
+      throw new Error(`Invalid workspace MCP configuration: ${this.configPath}`);
+    }
+    const servers = config.mcpServers ?? {};
+    if (!servers || typeof servers !== "object" || Array.isArray(servers)) {
+      throw new Error(`Invalid mcpServers object: ${this.configPath}`);
+    }
+    if (Object.hasOwn(servers, this.serverName)) {
+      throw new Error(`Workspace MCP entry already exists: ${this.serverName}`);
+    }
+    const entry = { serverUrl: url, headers: { "x-pi-bridge-token": token } };
+    this.#originalConfigExisted = existed;
+    this.#originalConfigRaw = originalRaw;
+    this.#originalConfig = originalRaw === undefined ? undefined : JSON.parse(originalRaw);
+    this.#mcpEntry = entry;
+    fs.mkdirSync(path.dirname(this.configPath), { recursive: true });
+    fs.writeFileSync(
+      this.configPath,
+      `${JSON.stringify({ ...config, mcpServers: { ...servers, [this.serverName]: entry } }, null, 2)}\n`,
+      "utf8",
+    );
+  }
+
+  dispose() {
+    this.#removeMcpServer();
+    if (this.#agentContent !== undefined && fs.existsSync(this.agentPath)) {
+      if (fs.readFileSync(this.agentPath, "utf8") === this.#agentContent) {
+        fs.unlinkSync(this.agentPath);
+        emptyDirectory(this.agentDirectory);
+        emptyDirectory(path.dirname(this.agentDirectory));
+      }
+    }
+    this.#agentContent = undefined;
+  }
+
+  #removeMcpServer() {
+    if (!this.#mcpEntry || !fs.existsSync(this.configPath)) return;
+    const currentRaw = fs.readFileSync(this.configPath, "utf8");
+    const current = JSON.parse(currentRaw);
+    const servers = current?.mcpServers;
+    if (!servers || !sameJson(servers[this.serverName], this.#mcpEntry)) return;
+    const next = { ...current, mcpServers: { ...servers } };
+    delete next.mcpServers[this.serverName];
+    if (!Object.hasOwn(this.#originalConfig ?? {}, "mcpServers") && Object.keys(next.mcpServers).length === 0) {
+      delete next.mcpServers;
+    }
+    if (sameJson(next, this.#originalConfig ?? {})) {
+      if (this.#originalConfigExisted) {
+        fs.writeFileSync(this.configPath, this.#originalConfigRaw, "utf8");
+      } else {
+        fs.unlinkSync(this.configPath);
+        emptyDirectory(path.dirname(this.configPath));
+        emptyDirectory(path.dirname(path.dirname(this.configPath)));
+      }
+    } else {
+      fs.writeFileSync(this.configPath, `${JSON.stringify(next, null, 2)}\n`, "utf8");
+    }
+    this.#mcpEntry = undefined;
+  }
+}
