+
+// Choose one capture source. Screen pixels cannot substitute for a background window.
+#[cfg(any(windows, test))]
+fn capture_selected_pixels(
+    foreground: bool,
+    bits: &mut [u8],
+    capture_screen: impl FnOnce(&mut [u8]) -> bool,
+    capture_window: impl FnOnce(&mut [u8]) -> bool,
+) -> Result<&'static str, ProtocolError> {
+    if foreground {
+        if capture_screen(bits) {
+            return Ok("screen-region");
+        }
+        return Err(ProtocolError::new(
+            "Foreground screen-region capture failed or target lost focus",
+            ErrorCode::CaptureFailed,
+        ));
+    }
+    if !capture_window(bits) || bits.chunks_exact(4).step_by(97)
+        .all(|pixel| pixel[0] < 8 && pixel[1] < 8 && pixel[2] < 8)
+    {
+        return Err(ProtocolError::new(
+            "Background PrintWindow capture failed or returned a near-black image",
+            ErrorCode::CaptureFailed,
+        ));
+    }
+    Ok("window")
 }
 
