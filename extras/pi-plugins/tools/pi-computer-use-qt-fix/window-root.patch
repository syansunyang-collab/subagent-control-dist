+// The outer window node and its real UIA root share an observed identity.
+// Bind after attaching retained UIA objects so raw window input uses the same
+// foreground, visibility and occlusion checks as other observed elements.
+fn bind_outline_root(
+    root_ref: &str,
+    look_id: &str,
+    elements: &[Value],
+    records: &mut HashMap<String, ElementRecord>,
+) {
+    if let Some(element) = elements
+        .first()
+        .and_then(|raw| raw.get("ref"))
+        .and_then(Value::as_str)
+        .and_then(|reference| records.get(&format!("win:{look_id}:{reference}")))
+        .cloned()
+    {
+        records.insert(root_ref.to_owned(), element);
+    }
+}
