{
	"name": "pi-cursor-host",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Pi model provider that runs Cursor local agents through the official SDK while Pi owns tools and prompts.",
	"engines": {
		"node": ">=22.19.0"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"probe": "node scripts/probe.mjs",
		"test": "node --experimental-strip-types --test test/*.test.mjs",
		"probe:hold": "node scripts/hold-probe.mjs",
		"probe:skills": "node scripts/skills-probe.mjs",
		"probe:steer": "node scripts/steer-probe.mjs",
		"probe:retry": "node scripts/retry-probe.mjs",
		"probe:rules": "node scripts/rules-probe.mjs",
		"probe:cancel": "node scripts/cancel-probe.mjs",
		"probe:steps": "node scripts/steps-probe.mjs",
		"probe:cache": "node scripts/cache-probe.mjs",
		"probe:cache-tools": "node scripts/cache-probe-tools.mjs"
	},
	"dependencies": {
		"@cursor/sdk": "1.0.31"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	}
}
