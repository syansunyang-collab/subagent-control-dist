    "approved_extra_modules": [],
    "maintenance_only_patterns": [
      "*_selftest.py",
      "*benchmark*.py"
    ]
  },
  "dependencies": {
    "node": {
      "requires": ">=18",
      "bundled": [
        "@modelcontextprotocol/sdk",
        "smol-toml",
        "zod",
        "zod-to-json-schema",
        "ajv",
        "ajv-formats",
        "fast-deep-equal",
        "fast-uri",
        "json-schema-traverse"
      ],
      "external_native": [
        "@koromix/koffi-<platform>"
      ]
    },
    "python": {
      "requires": ">=3.12",
      "stdlib_only": true
    },
    "native": {
      "packages": [
        "@koromix/koffi-<platform>"
      ],
      "note": "Koffi 是外部原生依赖，必须随包携带目标平台包；消费者不运行 npm ci --prefix ops。"
    }
  },
